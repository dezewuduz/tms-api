@model TmsMvc.Models.Student

<h2>Create Student</h2>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div>
        <label asp-for="RegistrationNumber"></label>
        <input asp-for="RegistrationNumber" />
        <span asp-validation-for="RegistrationNumber" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="GPA"></label>
        <input asp-for="GPA" />
        <span asp-validation-for="GPA" class="text-danger"></span>
    </div>

    <button type="submit">Create</button>

</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}