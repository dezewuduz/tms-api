@model TmsMvc.Models.Student

<h2>Student Details</h2>

<dl class="row">
    <dt class="col-sm-3">Registration Number</dt>
    <dd class="col-sm-9">@Model.RegistrationNumber</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">GPA</dt>
    <dd class="col-sm-9">@Model.GPA</dd>

    <dt class="col-sm-3">Active</dt>
    <dd class="col-sm-9">@Model.IsActive</dd>
</dl>

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-primary">
    Edit
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Back
</a>